#!/usr/bin/env bash
# LLDPq-IB Trigger - Self-loop daemon for web interface refresh buttons.
# Maps Refresh actions from the UI to IB collection scripts:
#   /tmp/.lldp_web_trigger      -> ib-assets.sh + ib-monitor.sh (IB Discovery refresh)
#   /tmp/.monitor_web_trigger   -> ib-monitor.sh                (Monitor refresh)
#   /tmp/.assets_web_trigger    -> ib-assets.sh                 (Assets refresh)
#   /tmp/.configs_web_trigger   -> get-configs.sh               (Configs refresh)
# Add to crontab: * * * * * /usr/local/bin/lldpq-trigger
# Copyright (c) 2024-2026 LLDPq Project - Licensed under MIT License

source /etc/lldpq.conf 2>/dev/null || true
LLDPQ_DIR="${LLDPQ_DIR:-$HOME/lldpq}"

# Map UI Refresh actions to the right collectors for the active data source.
# CLI-only MLNX-OS fabrics use UFM-backed collection (ufm-adapter + ib-hw-collect);
# the legacy SSH collectors (ib-monitor/ib-assets) only fit shell-capable switches.
TRIGGER_DATA_SOURCE="${LLDPQ_DATA_SOURCE:-auto}"
if [ "$TRIGGER_DATA_SOURCE" = "auto" ]; then
    if [ -n "${UFM_URL:-}" ]; then TRIGGER_DATA_SOURCE="hybrid"; else TRIGGER_DATA_SOURCE="ssh"; fi
fi
if [ "$TRIGGER_DATA_SOURCE" = "ufm" ] || [ "$TRIGGER_DATA_SOURCE" = "hybrid" ]; then
    LLDP_CMD='python3 ufm-adapter.py'
    MONITOR_CMD='python3 ufm-adapter.py; bash ib-hw-collect.sh'
    ASSETS_CMD='bash ib-hw-collect.sh; python3 ufm-adapter.py'
else
    LLDP_CMD='./ib-assets.sh; ./ib-monitor.sh'
    MONITOR_CMD='./ib-monitor.sh'
    ASSETS_CMD='./ib-assets.sh'
fi
CONFIGS_CMD='./get-configs.sh'

LLDP_TRIGGER_FILE="/tmp/.lldp_web_trigger"
MONITOR_TRIGGER_FILE="/tmp/.monitor_web_trigger"
ASSETS_TRIGGER_FILE="/tmp/.assets_web_trigger"
CONFIGS_TRIGGER_FILE="/tmp/.configs_web_trigger"
DAEMON_PID_FILE="/tmp/lldp_trigger_daemon.pid"
LLDP_LOCK_FILE="/tmp/lldp_running.lock"
ASSETS_LOCK_FILE="/tmp/assets_running.lock"
CONFIGS_LOCK_FILE="/tmp/configs_running.lock"

# Exit if daemon already running
if [ -f "$DAEMON_PID_FILE" ]; then
    # Check if process is actually running
    if kill -0 "$(cat "$DAEMON_PID_FILE")" 2>/dev/null; then
        exit 0
    else
        # Stale PID file, remove it
        rm -f "$DAEMON_PID_FILE"
    fi
fi

# Create PID file for daemon
echo $$ > "$DAEMON_PID_FILE"

# Cleanup function - only remove PID file if it belongs to us
cleanup() {
    if [ -f "$DAEMON_PID_FILE" ] && [ "$(cat "$DAEMON_PID_FILE" 2>/dev/null)" = "$$" ]; then
        rm -f "$DAEMON_PID_FILE"
    fi
    exit 0
}

# Set trap for cleanup on exit
trap cleanup SIGTERM SIGINT EXIT

# Wait function to prevent conflicts
wait_until_not_running() {
    local script_name="${1#./}"
    local pattern="(^|/|[[:space:]])${script_name}([[:space:]]|$)"
    while pgrep -f "$pattern" >/dev/null; do
        sleep 2
    done
}

# Main daemon loop - check every 5 seconds
LLDP_LAST_CHECK_FILE="$LLDPQ_DIR/.last_lldp_trigger_check"
MONITOR_LAST_CHECK_FILE="$LLDPQ_DIR/.last_monitor_trigger_check"
ASSETS_LAST_CHECK_FILE="$LLDPQ_DIR/.last_assets_trigger_check"
CONFIGS_LAST_CHECK_FILE="$LLDPQ_DIR/.last_configs_trigger_check"

while true; do
    # Check LLDP trigger
    LLDP_LAST_CHECK=0
    if [ -f "$LLDP_LAST_CHECK_FILE" ]; then
        LLDP_LAST_CHECK=$(cat "$LLDP_LAST_CHECK_FILE")
    fi

    if [ -f "$LLDP_TRIGGER_FILE" ]; then
        LLDP_TRIGGER_TIME=$(stat -c %Y "$LLDP_TRIGGER_FILE" 2>/dev/null || stat -f %m "$LLDP_TRIGGER_FILE" 2>/dev/null || echo 0)
        
        if [ "$LLDP_TRIGGER_TIME" -gt "$LLDP_LAST_CHECK" ]; then
            if [ -f "$LLDP_LOCK_FILE" ] && kill -0 "$(cat "$LLDP_LOCK_FILE")" 2>/dev/null; then
                : # IB Discovery refresh already running, skipping trigger
            else
                {
                    echo $$ > "$LLDP_LOCK_FILE"
                    echo "$LLDP_TRIGGER_TIME" > "$LLDP_LAST_CHECK_FILE"
                    cd "$LLDPQ_DIR"

                    # IB Discovery refresh (data-source aware: UFM adapter or legacy SSH)
                    eval "$LLDP_CMD" >/dev/null 2>&1

                    rm -f "$LLDP_LOCK_FILE"
                }
            fi
        fi
    fi

    # Check Monitor trigger
    MONITOR_LAST_CHECK=0
    if [ -f "$MONITOR_LAST_CHECK_FILE" ]; then
        MONITOR_LAST_CHECK=$(cat "$MONITOR_LAST_CHECK_FILE")
    fi

    if [ -f "$MONITOR_TRIGGER_FILE" ]; then
        MONITOR_TRIGGER_TIME=$(stat -c %Y "$MONITOR_TRIGGER_FILE" 2>/dev/null || stat -f %m "$MONITOR_TRIGGER_FILE" 2>/dev/null || echo 0)
        
        if [ "$MONITOR_TRIGGER_TIME" -gt "$MONITOR_LAST_CHECK" ]; then
            echo "$MONITOR_TRIGGER_TIME" > "$MONITOR_LAST_CHECK_FILE"
            cd "$LLDPQ_DIR"
            eval "$MONITOR_CMD" >/dev/null 2>&1
        fi
    fi

    # Check Assets trigger
    ASSETS_LAST_CHECK=0
    if [ -f "$ASSETS_LAST_CHECK_FILE" ]; then
        ASSETS_LAST_CHECK=$(cat "$ASSETS_LAST_CHECK_FILE")
    fi

    if [ -f "$ASSETS_TRIGGER_FILE" ]; then
        ASSETS_TRIGGER_TIME=$(stat -c %Y "$ASSETS_TRIGGER_FILE" 2>/dev/null || stat -f %m "$ASSETS_TRIGGER_FILE" 2>/dev/null || echo 0)
        
        if [ "$ASSETS_TRIGGER_TIME" -gt "$ASSETS_LAST_CHECK" ]; then
            if [ -f "$ASSETS_LOCK_FILE" ] && kill -0 "$(cat "$ASSETS_LOCK_FILE")" 2>/dev/null; then
                : # Assets refresh already running, skipping trigger
            else
                {
                    echo $$ > "$ASSETS_LOCK_FILE"
                    echo "$ASSETS_TRIGGER_TIME" > "$ASSETS_LAST_CHECK_FILE"
                    cd "$LLDPQ_DIR"
                    eval "$ASSETS_CMD" >/dev/null 2>&1
                    rm -f "$ASSETS_LOCK_FILE"
                }
            fi
        fi
    fi

    # Check Config collection trigger
    CONFIGS_LAST_CHECK=0
    if [ -f "$CONFIGS_LAST_CHECK_FILE" ]; then
        CONFIGS_LAST_CHECK=$(cat "$CONFIGS_LAST_CHECK_FILE")
    fi

    if [ -f "$CONFIGS_TRIGGER_FILE" ]; then
        CONFIGS_TRIGGER_TIME=$(stat -c %Y "$CONFIGS_TRIGGER_FILE" 2>/dev/null || stat -f %m "$CONFIGS_TRIGGER_FILE" 2>/dev/null || echo 0)

        if [ "$CONFIGS_TRIGGER_TIME" -gt "$CONFIGS_LAST_CHECK" ]; then
            if [ -f "$CONFIGS_LOCK_FILE" ] && kill -0 "$(cat "$CONFIGS_LOCK_FILE")" 2>/dev/null; then
                : # Config collection already running, skipping trigger
            else
                {
                    echo $$ > "$CONFIGS_LOCK_FILE"
                    echo "$CONFIGS_TRIGGER_TIME" > "$CONFIGS_LAST_CHECK_FILE"
                    cd "$LLDPQ_DIR"
                    eval "$CONFIGS_CMD" >/dev/null 2>&1
                    rm -f "$CONFIGS_LOCK_FILE"
                }
            fi
        fi
    fi
    
    # Sleep for 3 seconds before next check
    sleep 3
done