/*
 * Copyright (c) 2024-2026 LLDPq Project
 * Licensed under MIT License - see LICENSE file for details
 *
 * =============================================================================
 * TOPOLOGY.DOT - LLDPq-IB Expected Network Topology Definition
 * =============================================================================
 *
 * PURPOSE:
 *   Define the EXPECTED InfiniBand fabric wiring (the design). LLDPq-IB
 *   compares this graph against what `ib ibnetdiscover` actually reports and
 *   flags discrepancies (missing cables, mis-wires, extra cables).
 *
 * FORMAT:
 *   GraphViz DOT undirected edges. Each link is one edge between two ports.
 *     "Hostname1":"IB1/n" -- "Hostname2":"IB1/m"
 *
 * PORT NAMING (MLNX-OS):
 *   - Cage ports:  IB1/1, IB1/2, ..., IB1/N  (per QM9700: N=64)
 *   - Breakouts:   IB1/1/1, IB1/1/2 (when 1x 800G OSFP is split to 2x 400G)
 *
 * VALIDATION OUTPUT (Topology page):
 *   - LLDP matches DOT  -> green link
 *   - LLDP missing DOT  -> orange link  (unexpected wiring)
 *   - DOT missing LLDP  -> red link     (cable not present)
 *
 * MAINTENANCE:
 *   - Edit when you add / remove cables
 *   - Hostnames must match devices.yaml entries
 *   - Use this file as the single source of truth for the design
 *
 * =============================================================================
 */

graph "IB-Fabric" {

# --------------------------------------------------------------------------
# Replace this section with your real wiring. The example below is a 2-tier
# fat-tree pattern -- 2 spines, 2 leaves, fully meshed uplinks -- for shape
# reference only. Delete it when wiring real switches.
#
# (When the container runs with LLDPQ_DEMO=true, the entrypoint replaces
# this file with the 4-spine + 8-leaf + 16-HCA demo topology.)
# --------------------------------------------------------------------------

# Spine <-> Leaf uplinks (each leaf to every spine)
# "ib-leaf-01":"IB1/1" -- "ib-spine-01":"IB1/1"
# "ib-leaf-01":"IB1/2" -- "ib-spine-02":"IB1/1"
# "ib-leaf-02":"IB1/1" -- "ib-spine-01":"IB1/2"
# "ib-leaf-02":"IB1/2" -- "ib-spine-02":"IB1/2"

# Host downlinks (HCA <-> leaf)
# "ib-host-01":"IB1/1" -- "ib-leaf-01":"IB1/5"
# "ib-host-02":"IB1/1" -- "ib-leaf-01":"IB1/6"

}
